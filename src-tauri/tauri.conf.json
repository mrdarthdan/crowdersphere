{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrowderSphere",
  "identifier": "blog.dancrowder.crowdersphere",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CrowderSphere",
        "width": 1440,
        "height": 960,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http: csfiles: http://csfiles.localhost",
        "font-src": "'self' data:",
        "media-src": "'self' blob: csfiles: http://csfiles.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost csfiles: http://csfiles.localhost https: data: blob:",
        "frame-src": "'self' about: blob: data:"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Write WordPress posts on your computer",
    "longDescription": "CrowderSphere is a desktop editor for writing WordPress posts. Posts are saved as plain folders on your computer, and one click sends a post and its pictures to your blog.",
    "copyright": "Copyright (c) 2026 Daniel Crowder. MIT License.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "publisher": "Daniel Crowder",
    "homepage": "https://github.com/mrdarthdan/crowdersphere"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyQUVERjFDNkE3QkJFODEKUldTQnZudHFITit1a29BK0FlT3RHeExPbmtmNVZYRldUYllucmtIYkUrRGVaRFBXVGRkZzJzeFgK",
      "endpoints": [
        "https://github.com/mrdarthdan/crowdersphere/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
